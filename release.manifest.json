    {"module":"Core", "required":["Unity 2019.4 / .NET Framework 4.6.2"], "resources":[], "fallback":"Shared required assembly for migrated helpers, no BepInEx entry or automatic GPU work. Do not install migrated BSDF/SceneEffects without this DLL."},
